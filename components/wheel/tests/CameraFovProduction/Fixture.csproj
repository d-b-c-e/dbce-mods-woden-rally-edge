<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework><OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable><NoWarn>CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ProductionRoot)/WodenRallyEdge.Core/WodenRallyEdge.Core.csproj" />
    <Compile Include="$(ProductionRoot)/WodenRallyEdge.Plugin/CameraFramingStore.cs" />
    <Compile Include="$(ProductionRoot)/WodenRallyEdge.Plugin/TripleGeometry.cs" />
    <Compile Include="$(ProductionRoot)/WodenRallyEdge.Plugin/Toolkit/Triple/*.cs" />
    <Compile Include="$(HarnessRoot)/Program.cs;$(HarnessRoot)/Host.cs;$(GeneratedRoot)/TripleView.Fov.cs" />
    <Reference Include="BepInEx.Core"><HintPath>$(LibDir)/core/BepInEx.Core.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(LibDir)/core/SemanticVersioning.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
