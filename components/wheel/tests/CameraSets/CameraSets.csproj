    <Reference Include="BepInEx.Core" HintPath="../../lib/core/BepInEx.Core.dll" />
    <Reference Include="SemanticVersioning" HintPath="../../lib/core/SemanticVersioning.dll" />
  </ItemGroup>
</Project>
