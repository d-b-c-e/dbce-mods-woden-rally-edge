    <Compile Include="$(ProductionRoot)/WodenRallyEdge.Plugin/CurvedRig.cs" Link="Production/CurvedRig.cs" />
    <Compile Include="$(ProductionRoot)/WodenRallyEdge.Plugin/CameraFramingStore.cs" Link="Production/CameraFramingStore.cs" />
