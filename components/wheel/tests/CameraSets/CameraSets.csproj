<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ProductionRoot Condition="'$(ProductionRoot)' == ''">../../src</ProductionRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ProductionRoot)/WodenRallyEdge.Core/WodenRallyEdge.Core.csproj" />
